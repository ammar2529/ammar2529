    <script src="Scripts/eForms/iRental/Searchcollapsible.js"></script>
    <link rel="canonical" href="https://getbootstrap.com/docs/5.3/examples/footers/">

    <asp:Literal ID="ltrScrpt" runat="server"></asp:Literal>
    <style>
        /* Default input styles */
        .form-floating .form-control,
        .form-floating .form-select {
            border: none;
            border-bottom: 2px solid #6c757d; /* Gray bottom border by default */
            border-radius: 0;
            outline: none;
            box-shadow: none;
            height: auto; /* Override any previous height */
            padding-bottom: 0.1rem; /* Minimal padding to bring label/placeholder close to border */
            padding-top: 1rem; /* Enough space for label to float above */
        }

        /* Focus styles */
        .form-floating .form-control:focus,
        .form-floating .form-select:focus {
            border-bottom: 3px solid #ff6200; /* Orange on focus */
            outline: none;
            box-shadow: none;
        }

        /* Filled styles */
        .form-floating .form-control:not(:placeholder-shown),
        .form-floating .form-select:not(:placeholder-shown) {
            border-bottom: 3px solid #ff6200; /* Orange when filled */
        }

        /* Placeholder styles - hidden by default since label acts as placeholder */
        .form-floating .form-control::placeholder {
            color: transparent; /* Placeholder attribute hidden */
            opacity: 0;
        }

        /* Label styles - acts as placeholder by default */
        .form-floating label {
            color: #6c757d; /* Gray like a placeholder when not focused */
            opacity: 1; /* Visible by default as placeholder */
            transform: translateY(0.1rem); /* Positioned right next to bottom border */
            transition: all 0.2s ease; /* Smooth transition for transform and color */
            pointer-events: none; /* Prevent label from interfering with input clicks */
        }

        /* Label behavior when focused or filled */
        .form-floating .form-control:focus ~ label,
        .form-floating .form-control:not(:placeholder-shown) ~ label {
            color: #ff6200; /* Orange when focused or filled */
            transform: translateY(-0.5rem) scale(0.75); /* Float up and scale like Bootstrap */
        }

        /* Adjust select height and padding */
        .form-floating .form-select {
            padding-top: 1rem; /* Space for label to float */
            padding-bottom: 0.1rem; /* Close to bottom border */
        }

        /* Style the default (unselected) option in select */
        .form-floating .form-select option[value=""] {
            color: #6c757d; /* Gray for the default 'Select...' option */
        }

        /* Ensure selected option text remains readable */
        .form-floating .form-select:not(:placeholder-shown) {
            color: #000; /* Black for selected option text */
        }

        /* Button alignment */
        .d-flex.align-items-center .btn {
            margin-top: 0; /* Remove extra margin if any */
        }

        /* Plaintext input styles */
        .form-floating .form-control-plaintext {
            border-bottom: 2px dotted gray;
            border-radius: 0;
            padding-bottom: 5px; /* Optional: Spacing for better visibility */
        }

        .form-floating .form-control-plaintext:focus {
            border-bottom: 2px dotted #808080; /* Slightly darker gray on focus */
            outline: none;
        }


.form-floating .form-control.invalid {
    border-bottom: 3px solid red !important;
}

.form-floating label.invalid {
    color: red !important;
}

        /* Responsive margin adjustments */
        @media (max-width: 575.98px) { /* Bootstrap's 'sm' breakpoint */
            .form-floating {
                margin-bottom: 1rem !important; /* Ensure spacing on small devices */
            }
            .row.mt-2 {
                margin-top: 0.5rem !important; /* Reduce row spacing on small devices */
            }
        }

        @media (min-width: 576px) and (max-width: 991.98px) { /* Between 'sm' and 'lg' */
            .form-floating {
                margin-bottom: 1.5rem !important; /* Slightly more spacing */
            }
        }
    </style>
</head>

<body id="mainPageBody">
    <div class="mt-4 border">
        <form id="frmMain" runat="server">
            <div id="MainContainer">
                <WP:eForms_Header ID="eForms_Header" runat="server" />
                <asp:ContentPlaceHolder ID="BuDastoorHome" runat="server">
                    <!-- Example form for testing -->
                    <div class="container text-center">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">Test Form</h5>
                                <div class="form-floating mb-3">
                                    <input type="text" class="form-control" id="exampleInput" placeholder="Example">
                                    <label for="exampleInput">Example</label>
                                </div>
                                <div class="form-floating mb-3">
                                    <select class="form-select" id="exampleSelect">
                                        <option value="" selected>Select Option</option>
                                        <option value="1">Option 1</option>
                                        <option value="2">Option 2</option>
                                    </select>
                                    <label for="exampleSelect">Select Option</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </asp:ContentPlaceHolder>
                <WP:eForms_Footer ID="eForms_Footer" runat="server" />
                <asp:HiddenField ID="_CurrentLang" runat="server" />
                <asp:HiddenField ID="_PostCountry" runat="server" />
            </div>
        </form>
    </div>

    <script type="text/javascript">
        $().ready(function () {
            $('.CopyRight').text(`Copyright © ${(new Date()).getFullYear()} All rights reserved.`);

            $('.form-floating .form-control').on('blur', function () {
                debugger
                if (!$(this).val()) {
                    $(this).addClass('invalid');
                    $(this).siblings('label').addClass('invalid');
                } else {
                    $(this).removeClass('invalid');
                    $(this).siblings('label').removeClass('invalid');
                }
            });

        });
    </script>
    <script src="App_Themes/eForms_Theme/StyleSheets/bootstrap.bundle.min.js"></script></body>
</html>

