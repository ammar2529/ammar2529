    <script src="AsyncWidgets/Scripts/spinner.js"></script>
    <script src="Scripts/eForms/iRental/Searchcollapsible.js"></script>
    <script src="App_Themes/eForms_Theme/StyleSheets/bootstrap.bundle.min.js"></script>

    <asp:Literal ID="ltrScrpt" runat="server"></asp:Literal>

    <style>
        /* Layout Container */
        .page-wrapper {
            display: flex;
            min-height: 100vh;
            overflow-x: hidden; /* Prevent horizontal scroll */
        }

        /* Sidebar (styled in eForms_Header.ascx) */
        .sidebar {
            width: 250px;
            flex-shrink: 0;
        }

        /* Main Content */
        .main-content {
            flex-grow: 1;
            margin-left: 250px;
            padding: 20px;
            background-color: #ebeff3;
            transition: filter 0.3s ease; /* Smooth blur transition */
        }

        /* Overlay for Sidebar */
        .sidebar-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 1029;
        }

        .sidebar.active ~ .sidebar-overlay {
            display: block;
        }

        /* Responsive Design */
        @media (max-width: 991.98px) {
            .main-content {
                margin-left: 0;
            }
        }

        /* Prevent stretching */
        body {
            overflow-x: hidden;
        }

        /* Your existing styles */
        .nav-pills {
            position: relative;
            background-color: #12344d;
            padding: 5px;
        }

        .nav-pills .nav-link.active, .nav-pills .show>.nav-link {
            color: #fff;
            background-color: inherit;
            position: relative;
        }

        .nav-pills .nav-link.active::after {
            content: '';
            position: absolute;
            bottom: -6.5px;
            left: 0;
            width: 100%;
            height: 3px;
            background-color: #d86018;
            transform: scaleX(1);
            transform-origin: left;
            transition: transform 0.3s ease, left 4s ease, width 0.3s ease;
        }

        .nav-pills-Home .nav-link.active::after {
            content: '';
            position: absolute;
            bottom: -8px;
            left: 0;
            width: 100%;
            height: 3px;
            background-color: #d86018;
            transform: scaleX(1);
            transform-origin: left;
            transition: transform 0.3s ease, left 4s ease, width 0.3s ease;
        }

        .nav .nav-link {
            color: #9f9f9f;
            padding: 4px 8px;
            font-family: OpenSans-Regular, Arial, Helvetica, sans-serif;
            font-size: 14px;
            font-weight: 500;
            padding-left: 24px;
            padding-right: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            line-height: 1.5;
        }

        .nav-pills .nav-link:not(.active)::after {
            content: none;
        }

        .nav-pills .nav-link:focus, .nav-pills .nav-link:active {
            outline: none;
            box-shadow: none;
        }

        select:focus {
            outline: none;
        }

        .custom-floating {
            position: relative;
            margin-bottom: 1rem;
            padding-top: 20px;
        }

        .custom-floating select.form-select {
            border: none;
            border-bottom: 1px solid rgba(148, 148, 148);
            border-radius: 0;
            box-shadow: none;
            outline: none;
            font-size: 13px;
            font-weight: 500;
            padding-top: 10px;
            padding-left: 0;
            padding-bottom: 0.5rem;
            transition: all 0.2s ease-in-out;
        }

        .custom-floating label {
            position: absolute;
            top: 50%;
            left: 0;
            transform: translateY(30%);
            color: #6c757d;
            pointer-events: none;
            transition: all 0.2s ease-in-out;
            background: #fff;
            padding: 0 0.25rem;
            font-size: 13px;
            font-weight: 500;
            width: calc(100% - 40px);
        }

        .custom-floating.floating label {
            top: 0;
            transform: translateY(90%) scale(0.85);
            color: #6c757d;
            font-size: 13px;
            font-weight: 400;
            width: auto;
        }

        .custom-floating select:focus {
            border-bottom: 2px solid #d86018;
            box-shadow: none;
        }

        .custom-floating select:focus + label {
            top: 30%;
            transform: translateY(50%);
            font-size: 13px;
            font-weight: 400;
            color: #d86018;
        }

        .custom-floating.floating select:focus + label {
            top: 0;
            transform: translateY(90%) scale(0.85);
            color: #d86018;
            font-size: 13px;
            font-weight: 400;
            padding-left: 0;
        }
    </style>
</head>

<body id="mainPageBody" style="background-color: #ebeff3">
    <div class="page-wrapper">
        <form id="frmMain" runat="server">
            <WP:eForms_Header ID="eForms_Header" runat="server" />
            <div class="main-content">
                <asp:ContentPlaceHolder ID="BuDastoorHome" runat="server">
                    <!-- Example form for testing -->
                    <div class="container text-center">
                        <!-- Content goes here -->
                    </div>
                </asp:ContentPlaceHolder>
                <%--<WP:eForms_Footer ID="eForms_Footer" runat="server" />--%>
                <asp:HiddenField ID="_CurrentLang" runat="server" />
                <asp:HiddenField ID="_PostCountry" runat="server" />
            </div>
            <div class="sidebar-overlay"></div>
        </form>
    </div>

    <!-- Overlay with Spinner and Text -->
    <div class="overlay" id="loadingOverlay" style="display:none">
        <div class="spinner-container">
            <div class="sleek-spinner"></div>
            <div class="overlay-text">Please wait, loading your content...</div>
        </div>
    </div>

    <div class="toast-container position-fixed top-0 start-50 translate-middle-x p-3">
        <div id="successToast" class="toast bg-success text-white" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header">
                <strong class="me-auto">Success</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body">
                Operation completed successfully!
            </div>
        </div>
    </div>

    <script type="text/javascript">
        $(document).ready(function () {
            $('.CopyRight').text(`Copyright © ${(new Date()).getFullYear()} All rights reserved.`);

            $('.form-floating .form-control').on('blur', function () {
                var isRequired = $(this).attr('required') || $(this).hasClass('required');
                var value = $(this).val().trim();
                if (isRequired && !value) {
                    $(this).addClass('invalid');
                    $(this).siblings('label').addClass('invalid');
                } else {
                    $(this).removeClass('invalid');
                    $(this).siblings('label').removeClass('invalid');
                }
            });

            $('.form-floating .form-control').on('focus', function () {
                $(this).removeClass('invalid');
                $(this).siblings('label').removeClass('invalid');
            });

            $('.ink-bar').removeClass('fw-bold h4 h5');
            $('.nav').removeClass('nav-tabs').addClass('nav-pills');

            $('.nav').css({
                'background-color': '#12344d',
                'padding': '5px',
                'height': '42px'
            });

            $('.form-floating .form-control-plaintext')
                .removeClass('form-control-plaintext')
                .addClass('form-control')
                .attr('readonly', false)
                .css({
                    'border-bottom': '1px dotted gray',
                    'pointer-events': 'none',
                    'width': '100%'
                });

            document.querySelectorAll('.custom-floating select').forEach(select => {
                function updateLabelState() {
                    if (select.value && select.value !== '') {
                        select.parentElement.classList.add('floating');
                    } else {
                        select.parentElement.classList.remove('floating');
                    }
                }

                updateLabelState();
                select.addEventListener('change', updateLabelState);
                select.addEventListener('focus', updateLabelState);
                select.addEventListener('blur', updateLabelState);
            });
        });
    </script>
</body>
</html>