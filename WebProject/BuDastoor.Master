<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="BuDastoor.master.cs" Inherits="WebProject.BuDastoor" %>

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="">
    <meta name="author" content="Mark Otto, Jacob Thornton, and Bootstrap contributors">
    <meta name="generator" content="Hugo 0.122.0">
    <title>Welcome to eForms - Paperless Office</title>
    <link rel="canonical" href="https://getbootstrap.com/docs/5.3/examples/footers/">
    <script src="../Scripts/jquery-3.4.1.js"></script>
    <script language='javascript' type='text/javascript'> ROOT_PATH = ''; BASE_PATH = "";</script>
    <link href="App_Themes/eForms_Theme/StyleSheets/bootstrap.min.css" rel="stylesheet" />
    <link href="App_Themes/eForms_Theme/StyleSheets/spinner.css" rel="stylesheet" />
    <link href="App_Themes/eForms_Theme/fontawsome/all.css" rel="stylesheet" />
    <link href="App_Themes/eForms_Theme/StyleSheets/ControllsAndSelect.css" rel="stylesheet" />
    <link href="App_Themes/eForms_Theme/StyleSheets/Dropdowns.css" rel="stylesheet" />
    <link href="App_Themes/eForms_Theme/StyleSheets/Widget.css" rel="stylesheet" />
    <link href="App_Themes/eForms_Theme/StyleSheets/NavTabs.css" rel="stylesheet" />
    <link href="App_Themes/eForms_Theme/StyleSheets/sidebar.css" rel="stylesheet" />
    <script src="AsyncWidgets/Scripts/jQueryUI/jquery-ui.js" type="text/javascript"></script>
    <script src="AsyncWidgets/Scripts/Custom-Ext.js" type="text/javascript"></script>
    <script src="AsyncWidgets/Scripts/jquery.alphanumeric.js" type="text/javascript"></script>
    <script type="text/javascript" src="../JQuery/Common.js"></script>
    <script src="AsyncWidgets/Scripts/jquery.autocomplete.js"></script>
    <script src="AsyncWidgets/Scripts/WidgetBase.js" type="text/javascript"></script>
    <script src="AsyncWidgets/Scripts/DataGrid.js" type="text/javascript"></script>
    <script src="AsyncWidgets/Scripts/FormWidget.js"></script>
    <script src="AsyncWidgets/Scripts/ellipsisManuIcon.js"></script>
    <script src="AsyncWidgets/Scripts/spinner.js"></script>
    <script type="text/javascript" src="../App_Themes/eForms_Theme/SweetAlert/sweetalert2@11.js"></script>
    <script src="Scripts/eForms/iRental/Searchcollapsible.js"></script>

    <style>
        @font-face {
            font-family: 'OpenSans-Regular';
            src: url('../fonts/OpenSans-Regular.woff2') format('woff2'), url('../fonts/OpenSans-Regular.woff') format('woff');
            font-weight: 400;
            font-style: normal;
        }

        @font-face {
            font-family: 'OpenSans-SemiBold';
            src: url('../fonts/OpenSans-SemiBold.woff2') format('woff2'), url('../fonts/OpenSans-SemiBold.woff') format('woff');
            font-weight: 600;
            font-style: normal;
        }

        body {
            font-family: Roboto-Regular, Arial, Helvetica, sans-serif;
            font-weight: 400;
            font-size: 13px;
            color: #333;
            background-color: #ebeff3;
            margin: 0;
            padding: 0;
        }


        .action-menu button {
  padding: 6px 10px;
  border: none;
  background-color: #f8f9fa;
  cursor: pointer;
  text-align: left;
  border-radius: 4px;
  transition: background-color 0.2s ease;
}


/* Hover styles */
.edit-btn:hover {
  background-color: #007bff;
  color: white;
}

.delete-btn:hover {
  background-color: #dc3545;
  color: white;
}




        .sidebar ul > li {
            cursor: pointer;
        }

        /* Page and Content Layout */
        .page-wrapper {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            box-sizing: border-box;
        }

        .main-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            width: calc(100% - 60px); /* Full width minus collapsed sidebar */
            margin-left: 60px; /* Align beside collapsed sidebar */
        }

        .content-wrapper {
            flex: 1;
            padding: 20px;
            box-sizing: border-box;
        }

        .footer {
            background-color: #f8f9fa;
            padding: 15px;
            text-align: center;
            border-top: 1px solid #e9ecef;
            width: 100%; /* Full width of main-content */
        }

        /* Small Screens */
        @media (max-width: 991.98px) 
        {


            .main-content {
                width: 100%; /* Full width */
                margin-left: 0; /* No offset */
            }


        }
    </style>
</head>

<body id="mainPageBody">
    <div class="page-wrapper">
        <form id="frmMain" runat="server">
            <asp:Literal ID="ltrScrpt" runat="server"></asp:Literal>
            <asp:Literal ID="MenuData" runat="server"></asp:Literal>
            <asp:HiddenField ID="_CurrentLang" runat="server" />
            <asp:HiddenField ID="_PostCountry" runat="server" />

            <!-- Sidebar Toggle Button -->
            <button class="sidebar-toggle-btn"><i class="fa-solid fa-bars menuBars"></i></button>

            <!-- Sidebar -->
            <div class="sidebar" id="sidebar">
                <div class="navbar-brand">
                    <div class="logo-container">
                        <i class="fa-solid fa-opencart"></i>
                        <h6 class="home" returntype="true" showwidget="frmInbox">BuDastoor</h6>
                    </div>
                </div>
                <ul class="navbar-nav" id="dynamicMenu">
                    <!-- Dynamic menu items will be injected here -->
                </ul>
                <div class="user-section">
                    <a class="dropdown-toggle d-flex align-items-center" id="navbarDropdownMenuAvatar" role="button" aria-expanded="false">
                        <i class="fa-solid fa-user"></i>
                        <span class="UserName"></span>
                    </a>
                    <ul class="dropdown-menu" aria-labelledby="navbarDropdownMenuAvatar">
                        <li>
                            <a class="dropdown-item settings">
                                <i class="fas fa-cog"></i><span class="menu-text">Settings</span>
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item report">
                                <i class="fas fa-file-alt"></i><span class="menu-text">Crystal Report</span>
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item logout">
                                <i class="fas fa-sign-out-alt"></i><span class="menu-text">Logout</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Main Content -->
            <div class="main-content" id="mainContent">
                <div class="content-wrapper">
                    <asp:ContentPlaceHolder ID="BuDastoorHome" runat="server">
                        <div class="container text-center">
                            <!-- Content goes here -->
                        </div>
                    </asp:ContentPlaceHolder>
                </div>
                <!-- Footer -->
                <div class="footer">
                    <p class="CopyRight"></p>
                </div>
            </div>
        </form>
    </div>

    <!-- Overlay with Spinner and Text -->
    <div class="overlay" id="loadingOverlay" style="display: none">
        <div class="spinner-container">
            <div class="sleek-spinner"></div>
            <div class="overlay-text">Please wait, loading your content...</div>
        </div>
    </div>

    <!-- Toast Container -->
    <div class="toast-container position-fixed top-0 start-50 translate-middle-x p-3">
        <div id="successToast" class="toast bg-success text-white" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header">
                <strong class="me-auto">Success</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body">
                Operation completed successfully!
            </div>
        </div>
    </div>

    <script type="text/javascript">
        $(document).ready(function () {
            $('.CopyRight').text(`Copyright © ${(new Date()).getFullYear()} All rights reserved.`);

            // Function to reset sidebar state based on screen size
            function resetSidebarState() {
                var sidebar = $('#sidebar');
                var toggleBtn = $('.sidebar-toggle-btn');
                if (window.innerWidth > 991.98) {
                    sidebar.addClass('collapsed').removeClass('active');
                    sidebar.css('transform', 'none'); // Clear transform
                    toggleBtn.hide().removeClass('active');
                    $('.menuBars').removeClass('fa-minus').addClass('fa-bars');
                    // Ensure all dropdowns are closed
                    $('.nav-item.dropdown, .user-section').removeClass('active');
                    $('.dropdown-menu').hide();
                } else {
                    sidebar.removeClass('collapsed').removeClass('active');
                    sidebar.css('transform', 'translateX(-250px)'); // Hide sidebar
                    toggleBtn.show().removeClass('active');
                    $('.menuBars').removeClass('fa-minus').addClass('fa-bars');
                    // Ensure all dropdowns are closed
                    $('.nav-item.dropdown, .user-section').removeClass('active');
                    $('.dropdown-menu').hide();
                }
            }

            // Initial sidebar state
            resetSidebarState();

            // Handle window resize to reset sidebar state
            $(window).on('resize', function () {
                resetSidebarState();
            });

            $('.form-floating .form-control').on('blur', function () {
                var isRequired = $(this).attr('required') || $(this).hasClass('required');
                var value = $(this).val().trim();
                if (isRequired && !value) {
                    $(this).addClass('invalid');
                    $(this).siblings('label').addClass('invalid');
                } else {
                    $(this).removeClass('invalid');
                    $(this).siblings('label').removeClass('invalid');
                }
            });

            $('.form-floating .form-control').on('focus', function () {
                $(this).removeClass('invalid');
                $(this).siblings('label').removeClass('invalid');
            });

            $('.form-floating .form-control-plaintext')
                .removeClass('form-control-plaintext')
                .addClass('form-control')
                .attr('readonly', true)
                .css({
                    'border-bottom': '2px dotted rgba(148,148,148)',
                    'pointer-events': 'none',
                    'width': '100%',
                    'font-size': '13px',
                    'font-weight': '400',
                    'font-family': 'OpenSans-Regular'
                });

            document.querySelectorAll('.custom-floating select').forEach(select => {
                function updateLabelState() {
                    if (select.value && select.value !== '') {
                        select.parentElement.classList.add('floating');
                    } else {
                        select.parentElement.classList.remove('floating');
                    }
                }
                updateLabelState();
                select.addEventListener('change', updateLabelState);
                select.addEventListener('focus', updateLabelState);
                select.addEventListener('blur', updateLabelState);
            });

            // Dynamic Menu Rendering
            try {
                var menuData = MenuData ? MenuData.Rows : null;
                var userName = AsyncWidgets.user ? AsyncWidgets.user.name : '';
                var userId = AsyncWidgets.user ? AsyncWidgets.user.id : '';
                var userRoles = AsyncWidgets.user && AsyncWidgets.user.conf ? AsyncWidgets.user.conf : '';
                var conUserRoles = userRoles ? decJSON(userRoles) : { Roles: '' };
                var roles = conUserRoles.Roles || '';
                var rolesArray = roles.split(',').filter(Boolean);

                if (rolesArray.includes("Car_Customer_Details")) {
                    console.log("Role Found: Car_Customer_Details");
                } else {
                    console.log("Role Not Found: Car_Customer_Details");
                }

                function renderMenu() {
                    if (!menuData) {
                        console.error("MenuData is undefined or null. Please ensure MenuData is populated in the code-behind.");
                        document.getElementById('dynamicMenu').innerHTML = '<li class="nav-item"><a class="nav-link">Menu Data Not Available</a></li>';
                        return;
                    }

                    var menuText = '';
                    for (var idx in menuData) {
                        var parentMenu = menuData[idx];
                        if (parentMenu.ParentMenuId != 0) {
                            continue;
                        }
                        if (parentMenu.MenuId == 0) {
                            menuText += '<li class="nav-item">';
                            menuText += '<a class="nav-link home" returntype="true" showwidget="frmInbox" style="padding-left:25px;">';
                            menuText += '<i class="fa-solid fa-house"></i><span class="menu-text"> ' + parentMenu.MenuName + '</span>';
                            menuText += '</a>';
                            menuText += '</li>';
                        } else if (hasChild(parentMenu.MenuId)) {
                            menuText += '<li class="nav-item dropdown">';
                            menuText += '<a class="nav-link dropdown-toggle" role="button" aria-expanded="false" style="padding-left:25px;">';
                            if (parentMenu.MenuName.toLowerCase() === 'hr') {
                                menuText += '<i class="fa-solid fa-users"></i><span class="menu-text"> ' + parentMenu.MenuName + '</span>';
                            } else {
                                menuText += '<i class="fa-solid fa-folder"></i><span class="menu-text"> ' + parentMenu.MenuName + '</span>';
                            }
                            menuText += '</a>';
                            menuText += '<ul class="dropdown-menu">';
                            for (var jdx in menuData) {
                                var childMenu = menuData[jdx];
                                if (parentMenu.MenuId == childMenu.ParentMenuId) {
                                    menuText += '<li><a class="dropdown-item" returntype="true" showwidget="' + childMenu.ShowWidget + '">';
                                    menuText += '<i class="fa-solid fa-file"></i><span class="menu-text"> ' + childMenu.MenuName + '</span>';
                                    menuText += '</a></li>';
                                }
                            }
                            menuText += '</ul>';
                            menuText += '</li>';
                        } else {
                            menuText += '<li class="nav-item">';
                            menuText += '<a class="nav-link" returntype="true" showwidget="' + parentMenu.ShowWidget + '" style="padding-left:25px;">';
                            menuText += '<i class="fa-solid fa-file"></i><span class="menu-text"> ' + parentMenu.MenuName + '</span>';
                            menuText += '</a>';
                            menuText += '</li>';
                        }
                    }
                    document.getElementById('dynamicMenu').innerHTML = menuText;
                }

                function hasChild(menuId) {
                    for (var i in menuData) {
                        if (menuData[i].ParentMenuId == menuId) {
                            return true;
                        }
                    }
                    return false;
                }

                renderMenu();
                AsyncWidgets.WidgetManager.bind($('#sidebar [showwidget]'));

                // Dropdown toggle handler for click (mobile and desktop)
                $('#sidebar .dropdown-toggle').on('click', function (e) {
                    e.preventDefault();
                    var $parent = $(this).parent();
                    var $dropdownMenu = $(this).next('.dropdown-menu');

                    // Toggle active class on parent
                    $parent.toggleClass('active');

                    // Toggle dropdown menu visibility
                    if ($parent.hasClass('active')) {
                        $dropdownMenu.show();
                    } else {
                        $dropdownMenu.hide();
                    }

                    // Close other open dropdowns
                    $('#sidebar .dropdown-toggle').not(this).parent().removeClass('active');
                    $('#sidebar .dropdown-menu').not($dropdownMenu).hide();
                });

                // Hover handler for large screens
                if (window.innerWidth > 991.98) {
                    $('#sidebar .nav-item.dropdown, #sidebar .user-section').on('mouseenter', function () {
                        // Close all other dropdowns
                        $('#sidebar .nav-item.dropdown, #sidebar .user-section').not(this).removeClass('active');
                        $('#sidebar .dropdown-menu').not($(this).find('.dropdown-menu')).hide();
                        // Open current dropdown
                        $(this).addClass('active');
                        $(this).find('.dropdown-menu').show();
                    });

                    $('#sidebar .nav-item.dropdown, #sidebar .user-section').on('mouseleave', function () {
                        // Only close if sidebar is not pinned
                        if (!$('.sidebar-toggle-btn').hasClass('active')) {
                            $(this).removeClass('active');
                            $(this).find('.dropdown-menu').hide();
                        }
                    });
                }
            } catch (e) {
                console.error("Error in menu rendering: ", e);
                document.getElementById('dynamicMenu').innerHTML = '<li class="nav-item"><a class="nav-link">Error Loading Menu</a></li>';
            }

            $('.logout').click(function () {
                var inv = new AsyncWidgets.RAInvoker();
                inv.invokeRA({
                    params: ["ActorId", "Authentication", "ActionId", "LogoutUser", "ServiceInfo", "<root><dummy></dummy></root>"]
                });
                AsyncWidgets.user.logout();
                inv.on('onSuccess', function (res) {
                    $('.card').hide();
                    window.location = "/Login.aspx";
                    window.location.pathname = BASE_PATH + "BuDastoorHome";
                });
            });

            if (userName) {
                $('.UserName').text(userName);
                $('.UserName').css('text-decoration', 'none');
            }
        });

        function toggleSidebar() {
            var sidebar = $('#sidebar');
            var toggleBtn = $('.sidebar-toggle-btn');

            if (window.innerWidth <= 991.98) {
                sidebar.toggleClass('active');
                if (sidebar.hasClass('active')) {
                    sidebar.css('transform', 'translateX(0)');
                    toggleBtn.show();
                    $('.menuBars').removeClass('fa-bars').addClass('fa-minus');
                } else {
                    sidebar.css('transform', 'translateX(-250px)');
                    toggleBtn.show();
                    $('.menuBars').removeClass('fa-minus').addClass('fa-bars');
                    // Close all dropdowns when sidebar is closed
                    $('.nav-item.dropdown, .user-section').removeClass('active');
                    $('.dropdown-menu').hide();
                }
            } else {
                sidebar.toggleClass('collapsed').toggleClass('active');
                sidebar.css('transform', 'none');
                toggleBtn.toggle();
                if (sidebar.hasClass('collapsed')) {
                    $('.menuBars').removeClass('fa-minus').addClass('fa-bars');
                    // Close all dropdowns when collapsing
                    $('.nav-item.dropdown, .user-section').removeClass('active');
                    $('.dropdown-menu').hide();
                } else {
                    $('.menuBars').removeClass('fa-bars').addClass('fa-minus');
                }
            }

            toggleBtn.toggleClass('active');
        }

        $('.sidebar-toggle-btn').on('click', toggleSidebar);

        $('#sidebar').on('mouseenter', function () {
            if (window.innerWidth > 991.98) {
                $(this).removeClass('collapsed').addClass('active');
                $('.menuBars').removeClass('fa-bars').addClass('fa-minus');
                $('.sidebar-toggle-btn').show();
            }
        });

        $('#sidebar').on('mouseleave', function () {
            if (window.innerWidth > 991.98 && !$('.sidebar-toggle-btn').hasClass('active')) {
                $(this).addClass('collapsed').removeClass('active');
                $('.menuBars').removeClass('fa-minus').addClass('fa-bars');
                $('.sidebar-toggle-btn').hide();
                // Close all dropdowns on mouse leave
                $('.nav-item.dropdown, .user-section').removeClass('active');
                $('.dropdown-menu').hide();
            }
        });
    </script>
    <script src="App_Themes/eForms_Theme/StyleSheets/bootstrap.bundle.min.js"></script>
</body>
</html>