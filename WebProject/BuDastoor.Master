    <style>
        @font-face {
            font-family: 'OpenSans-Regular';
            src: url('../fonts/OpenSans-Regular.woff2') format('woff2'),
                 url('../fonts/OpenSans-Regular.woff') format('woff');
            font-weight: 400;
            font-style: normal;
        }

        @font-face {
            font-family: 'OpenSans-SemiBold';
            src: url('../fonts/OpenSans-SemiBold.woff2') format('woff2'),
                 url('../fonts/OpenSans-SemiBold.woff') format('woff');
            font-weight: 600;
            font-style: normal;
        }

        body {
            font-family: Roboto-Regular, Arial, Helvetica, sans-serif;
            font-weight: 400;
            font-size: 13px;
            color: #333;
            background-color: #ebeff3;
            margin: 0;
            padding: 0;
        }

/*        .page-wrapper {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .content-wrapper {
            flex: 1;
            padding: 20px;
        }*/

        /* Sidebar Styles */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: 60px;
            height: 100%;
            background-color: #12344d;
            box-shadow: 2px 0 5px rgba(0, 0, 0, 0.1);
            z-index: 1030;
            overflow-y: auto;
            transition: width 0.3s ease-in-out;
        }

        .sidebar:hover {
            width: 250px !important;
            z-index: 1040; /* Ensure sidebar overlaps content */
        }

        .sidebar.collapsed {
            width: 80px !important;
        }

        .sidebar .navbar-brand {
            display: flex;
            align-items: center;
            padding: 15px;
            border-bottom: 1px solid #e9ecef;
            position: relative;
        }

        .sidebar .navbar-brand .logo-container {
            display: flex;
            align-items: center;
            flex-grow: 1;
        }

        .sidebar .navbar-brand h6 {
            margin: 0;
            font-size: 1.2rem;
            color: #ffffff;
        }

        .sidebar:not(:hover) .navbar-brand h6,
        .sidebar.collapsed .navbar-brand h6 {
            display: none;
        }

        .sidebar .navbar-brand .fa-opencart {
            font-size: 16px;
            margin-right: 10px;
            color: #ffffff;
        }

        .sidebar:not(:hover) .navbar-brand .fa-opencart,
        .sidebar.collapsed .navbar-brand .fa-opencart {
            margin-right: 0;
        }

        .sidebar .nav-item {
            width: 100%;
        }

        .sidebar .nav-link {
            color: #ffffff;
            padding: 10px 15px;
            display: flex;
            align-items: center;
            transition: background-color 0.2s ease;
        }

        .sidebar .nav-link:hover {
            background-color: #1a4a6b;
            color: #ff6200;
        }

        .sidebar .nav-link i {
            margin-right: 10px;
            font-size: 16px;
            color: #ffffff;
        }

        .sidebar:not(:hover) .nav-link .menu-text,
        .sidebar.collapsed .nav-link .menu-text {
            display: none;
        }

        .sidebar:not(:hover) .nav-link i,
        .sidebar.collapsed .nav-link i {
            margin-right: 0;
        }

        .sidebar .dropdown-menu {
            position: static;
            width: 100%;
            border: none;
            box-shadow: none;
            background-color: #1a4a6b;
            padding-left: 30px;
            display: none;
        }

        .sidebar .nav-item.dropdown:hover .dropdown-menu {
            display: block;
        }

        .sidebar:not(:hover) .dropdown-menu,
        .sidebar.collapsed .dropdown-menu {
            display: none !important;
        }

        .sidebar .dropdown-item {
            padding: 8px 15px;
            color: #ffffff;
            display: flex;
            align-items: center;
        }

        .sidebar .dropdown-item i {
            margin-right: 10px;
            color: #ffffff;
        }

        .sidebar .dropdown-item:hover {
            background-color: #2a5b8c;
            color: #ff6200;
        }

        .sidebar .user-section {
            padding: 15px;
            border-top: 1px solid #e9ecef;
            margin-top: auto;
        }

        .sidebar .user-section .dropdown-toggle {
            color: #ffffff;
            text-decoration: none;
            display: flex;
            align-items: center;
        }

        .sidebar .user-section .dropdown-toggle:hover {
            color: #ff6200;
        }

        .sidebar .user-section .dropdown-menu {
            position: static;
            width: 100%;
            background-color: #1a4a6b;
            display: none;
        }

        .sidebar .user-section:hover .dropdown-menu {
            display: block;
        }

        .sidebar:not(:hover) .user-section .UserName,
        .sidebar.collapsed .user-section .UserName {
            display: none;
        }

        .sidebar .logout i {
            color: #dc3545;
        }

        .sidebar-toggle-btn {
            background-color: #12344d;
            color: #ffffff;
            border: none;
            padding: 5px 10px;
            cursor: pointer;
            font-size: 16px;
            margin-right: 10px;
        }

        .sidebar:not(:hover) .sidebar-toggle-btn,
        .sidebar.collapsed .sidebar-toggle-btn {
            margin-right: 0;
        }
        .sidebar ul>li{
            cursor:pointer;
        }

        .main-content {
            /* Removed margin-left to prevent content shifting */
            transition: none; /* Remove transition to prevent movement */
        }

        /* Removed sidebar:hover ~ .main-content and .main-content.collapsed styles to prevent content shifting */

        @media (max-width: 991.98px) {
            .sidebar {
                transform: translateX(-250px);
                width: 250px;
            }

            .sidebar.active {
                transform: translateX(0);
            }

            .sidebar.collapsed {
                width: 60px;
            }

            .main-content {
                margin-left: 0;
            }

            .sidebar .nav-item.dropdown:hover .dropdown-menu,
            .sidebar .user-section:hover .dropdown-menu {
                display: none;
            }

            .sidebar .nav-item.dropdown .dropdown-menu,
            .sidebar .user-section .dropdown-menu {
                display: none !important;
            }

            .sidebar .nav-item.dropdown.show .dropdown-menu,
            .sidebar .user-section.show .dropdown-menu {
                display: block !important;
            }

            .sidebar:hover {
                width: 250px; /* Maintain mobile behavior */
            }
        }

        .footer {
    background-color: #f8f9fa;
    padding:15px;
    text-align: center;
    border-top: 1px solid #e9ecef;
    /* width: 100px; */
    position: relative;
    left: 77px;
    width: 96%;
    top: 5px;
        }

        .footer .CopyRight {
            margin: 0;
            font-size: 0.9rem;
            color: #333;
        }
    </style>
</head>

<body id="mainPageBody">
    <div class="page-wrapper">
        <form id="frmMain" runat="server">
            <asp:Literal ID="ltrScrpt" runat="server"></asp:Literal>
            <asp:Literal ID="MenuData" runat="server"></asp:Literal>
            <asp:HiddenField ID="_CurrentLang" runat="server" />
            <asp:HiddenField ID="_PostCountry" runat="server" />

            <!-- Sidebar -->
            <div class="sidebar" id="sidebar">
                <div class="navbar-brand">
                    <button class="sidebar-toggle-btn" style="padding-left:13px"><i class="fa-solid fa-bars menuBars"></i></button>
                    <div class="logo-container">
                        <h6 class="home" returntype="true" showwidget="frmInbox">BuDastoor</h6>
                    </div>
                </div>
                <ul class="navbar-nav" id="dynamicMenu">
                    <!-- Dynamic menu items will be injected here -->
                </ul>
                <div class="user-section">
                    <a class="dropdown-toggle d-flex align-items-center" id="navbarDropdownMenuAvatar" role="button" data-bs-toggle="dropdown" aria-expanded="false" style="padding-left:13px;">
                        <span class="UserName me-2"></span>
                        <i class="fa-solid fa-user"></i>
                    </a>
                    <ul class="dropdown-menu" aria-labelledby="navbarDropdownMenuAvatar">
                        <li>
                            <a class="dropdown-item settings">
                                <i class="fas fa-cog me-2"></i><span class="menu-text">Settings</span>
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item report">
                                <i class="fas fa-file-alt me-2"></i><span class="menu-text">Crystal Report</span>
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item logout">
                                <i class="fas fa-sign-out-alt me-2"></i><span class="menu-text">Logout</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Main Content -->
            <div class="main-content" id="mainContent">
                <div class="content-wrapper">
                    <asp:ContentPlaceHolder ID="BuDastoorHome" runat="server">
                        <div class="container text-center">
                            <!-- Content goes here -->
                        </div>
                    </asp:ContentPlaceHolder>
                </div>
                <!-- Footer -->
<%--                <div class="footer">
                    <p class="CopyRight"></p>
                </div>--%>
            </div>
        </form>
    </div>

    <!-- Overlay with Spinner and Text -->
    <div class="overlay" id="loadingOverlay" style="display:none">
        <div class="spinner-container">
            <div class="sleek-spinner"></div>
            <div class="overlay-text">Please wait, loading your content...</div>
        </div>
    </div>

    <!-- Toast Container -->
    <div class="toast-container position-fixed top-0 start-50 translate-middle-x p-3">
        <div id="successToast" class="toast bg-success text-white" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header">
                <strong class="me-auto">Success</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body">
                Operation completed successfully!
            </div>
        </div>
    </div>

    <script type="text/javascript">
        $(document).ready(function () {
            $('.CopyRight').text(`Copyright © ${(new Date()).getFullYear()} All rights reserved.`);

            // Ensure sidebar is collapsed by default on desktop
            if (window.innerWidth > 991.98) {
                $('#sidebar').addClass('collapsed');
                $('#mainContent').addClass('collapsed');
            }

            $('.form-floating .form-control').on('blur', function () {
                var isRequired = $(this).attr('required') || $(this).hasClass('required');
                var value = $(this).val().trim();
                if (isRequired && !value) {
                    $(this).addClass('invalid');
                    $(this).siblings('label').addClass('invalid');
                } else {
                    $(this).removeClass('invalid');
                    $(this).siblings('label').removeClass('invalid');
                }
            });

            $('.form-floating .form-control').on('focus', function () {
                $(this).removeClass('invalid');
                $(this).siblings('label').removeClass('invalid');
            });

            $('.form-floating .form-control-plaintext')
                .removeClass('form-control-plaintext')
                .addClass('form-control')
                .attr('readonly', true)
                .css({
                    'border-bottom': '2px dotted rgba(148,148,148)',
                    'pointer-events': 'none',
                    'width': '100%',
                    'font-size': '13px',
                    'font-weight': '400',
                    'font-family': 'OpenSans-Regular'
                });

            document.querySelectorAll('.custom-floating select').forEach(select => {
                function updateLabelState() {
                    if (select.value && select.value !== '') {
                        select.parentElement.classList.add('floating');
                    } else {
                        select.parentElement.classList.remove('floating');
                    }
                }
                updateLabelState();
                select.addEventListener('change', updateLabelState);
                select.addEventListener('focus', updateLabelState);
                select.addEventListener('blur', updateLabelState);
            });

            // Dynamic Menu Rendering
            try {
                var menuData = MenuData ? MenuData.Rows : null;
                var userName = AsyncWidgets.user ? AsyncWidgets.user.name : '';
                var userId = AsyncWidgets.user ? AsyncWidgets.user.id : '';
                var userRoles = AsyncWidgets.user && AsyncWidgets.user.conf ? AsyncWidgets.user.conf : '';
                var conUserRoles = userRoles ? decJSON(userRoles) : { Roles: '' };
                var roles = conUserRoles.Roles || '';
                var rolesArray = roles.split(',').filter(Boolean);

                if (rolesArray.includes("Car_Customer_Details")) {
                    console.log("Role Found: Car_Customer_Details");
                } else {
                    console.log("Role Not Found: Car_Customer_Details");
                }

                function renderMenu() {
                    if (!menuData) {
                        console.error("MenuData is undefined or null. Please ensure MenuData is populated in the code-behind.");
                        document.getElementById('dynamicMenu').innerHTML = '<li class="nav-item"><a class="nav-link">Menu Data Not Available</a></li>';
                        return;
                    }

                    var menuText = '';
                    for (var idx in menuData) {
                        var parentMenu = menuData[idx];
                        if (parentMenu.ParentMenuId != 0) {
                            continue;
                        }
                        if (parentMenu.MenuId == 0) {
                            menuText += '<li class="nav-item">';
                            menuText += '<a class="nav-link home" returntype="true" showwidget="frmInbox" style="padding-left:25px;">';
                            menuText += '<i class="fa-solid fa-house"></i><span class="menu-text"> ' + parentMenu.MenuName + '</span>';
                            menuText += '</a>';
                            menuText += '</li>';
                        } else if (hasChild(parentMenu.MenuId)) {
                            menuText += '<li class="nav-item dropdown">';
                            menuText += '<a class="nav-link dropdown-toggle" role="button" data-bs-toggle="dropdown" aria-expanded="false"; style="padding-left:25px;">';
                            if (parentMenu.MenuName.toLowerCase() === 'hr') {
                                menuText += '<i class="fa-solid fa-users"></i><span class="menu-text"> ' + parentMenu.MenuName + '</span>';
                            } else {
                                menuText += '<i class="fa-solid fa-folder"></i><span class="menu-text"> ' + parentMenu.MenuName + '</span>';
                            }
                            menuText += '</a>';
                            menuText += '<ul class="dropdown-menu">';
                            for (var jdx in menuData) {
                                var childMenu = menuData[jdx];
                                if (parentMenu.MenuId == childMenu.ParentMenuId) {
                                    menuText += '<li><a class="dropdown-item" returntype="true" showwidget="' + childMenu.ShowWidget + '">';
                                    menuText += '<i class="fa-solid fa-file"></i><span class="menu-text"> ' + childMenu.MenuName + '</span>';
                                    menuText += '</a></li>';
                                }
                            }
                            menuText += '</ul>';
                            menuText += '</li>';
                        } else {
                            menuText += '<li class="nav-item">';
                            menuText += '<a class="nav-link" returntype="true" showwidget="' + parentMenu.ShowWidget + '">';
                            menuText += '<i class="fa-solid fa-file"></i><span class="menu-text"> ' + parentMenu.MenuName + '</span>';
                            menuText += '</a>';
                            menuText += '</li>';
                        }
                    }
                    document.getElementById('dynamicMenu').innerHTML = menuText;
                }

                function hasChild(menuId) {
                    for (var i in menuData) {
                        if (menuData[i].ParentMenuId == menuId) {
                            return true;
                        }
                    }
                    return false;
                }

                renderMenu();
                AsyncWidgets.WidgetManager.bind($('#sidebar [showwidget]'));

                $('#sidebar .dropdown-toggle').on('click', function () {
                    if (window.innerWidth <= 991.98) {
                        $(this).parent().toggleClass('show');
                        $(this).next('.dropdown-menu').toggleClass('show');
                    }
                });
            } catch (e) {
                console.error("Error in menu rendering: ", e);
                document.getElementById('dynamicMenu').innerHTML = '<li class="nav-item"><a class="nav-link">Error Loading Menu</a></li>';
            }

            $('.logout').click(function () {
                var inv = new AsyncWidgets.RAInvoker();
                inv.invokeRA({
                    params: ["ActorId", "Authentication", "ActionId", "LogoutUser", "ServiceInfo", "<root><dummy></dummy></root>"]
                });
                AsyncWidgets.user.logout();
                inv.on('onSuccess', function (res) {
                    $('.card').hide();
                    window.location = "/Login.aspx";
                    window.location.pathname = BASE_PATH + "BuDastoorHome";
                });
            });

            if (userName) {
                $('.UserName').text(userName);
                $('.UserName').css('text-decoration', 'none');
            }
        });

        function toggleSidebar() {
            var sidebar = document.getElementById('sidebar');
            var mainContent = document.getElementById('mainContent');
            var toggleBtn = document.querySelector('.sidebar-toggle-btn');

            if (window.innerWidth <= 991.98) {
                sidebar.classList.toggle('active');
                mainContent.classList.toggle('full');
                $('.menuBars').removeClass('fa-minus').addClass('fa-bars');
            } else {
                sidebar.classList.toggle('collapsed');
                $('.menuBars').removeClass('fa-bars').addClass('fa-minus');
            }

            toggleBtn.classList.toggle('active');
        }

        $('#sidebar').on('mouseenter', function () {
            if (window.innerWidth > 991.98) {
                $(this).removeClass('collapsed');
            }
        });

        $('#sidebar').on('mouseleave', function () {
            if (window.innerWidth > 991.98) {
                $(this).addClass('collapsed');
            }
        });
    </script>
    <script src="App_Themes/eForms_Theme/StyleSheets/bootstrap.bundle.min.js"></script>
</body>
</html>
