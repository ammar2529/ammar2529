<div class="toast-container position-fixed top-0 start-50 translate-middle-x p-3">
    <div id="successToast" class="toast bg-success text-white" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header">
            <strong class="me-auto">Success</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
        </div>
        <div class="toast-body">
            Operation completed successfully!
        </div>
    </div>
</div>

    <script type="text/javascript">

        $(document).ready(function () {
            $('.CopyRight').text(`Copyright © ${(new Date()).getFullYear()} All rights reserved.`);

            $('.form-floating .form-control').on('blur', function () {
                var isRequired = $(this).attr('required') || $(this).hasClass('required'); // Check if 'required' attribute or class exists
                var value = $(this).val().trim(); // Remove extra spaces

                if (isRequired && !value) { // Apply validation only if 'required' exists
                    $(this).addClass('invalid');
                    $(this).siblings('label').addClass('invalid');
                } else {
                    $(this).removeClass('invalid');
                    $(this).siblings('label').removeClass('invalid');
                }
            });

            // Remove error styling when user focuses on the input
            $('.form-floating .form-control').on('focus', function () {
                $(this).removeClass('invalid');
                $(this).siblings('label').removeClass('invalid');
            });

            // $('.form-control-plaintext').prop('disabled', true); // Disable input field

            $('.ink-bar').removeClass('fw-bold h4 h5');
            $('.nav').removeClass('nav-tabs').addClass('nav-pills');

            // ✅ Fixed: Removed incorrect semicolon inside the `.css()` function
            $('.nav').css({
                'background-color': '#12344d',
                'padding': '5px',
                'height': '42px' // 🔹 Removed incorrect semicolon here
            });

            $('.form-floating .form-control-plaintext')
                .removeClass('form-control-plaintext')
                .addClass('form-control')
                .attr('readonly', false) // ✅ Read-only attribute set
                .css({
                    'border-bottom': '1px dotted gray',  // Gray dotted border
                    'pointer-events': 'none',      // 🔹 Disable clicking
                    // Adjust text spacing
                    'width': '100%'  ,            // Full width
                    'font-size': '13px',
                    'font-weight': '400',
                    'font- family': 'OpenSans-Regular'
                });

            /*$(".form-select").prop("selectedIndex", -1);*/
            //$('.form-floating .form-select ~ label').remove();

            $('.dropdown-select').on('click', function (e) {
                e.stopPropagation();
                var $dropdown = $(this).closest('.dropdown');
                $dropdown.toggleClass('active');
                $dropdown.find('.dropdown-list').toggleClass('show');
            });

            // Dropdown item par click event
            $('.dropdown-item').on('click', function () {
                var selectedText = $(this).text();
                var $dropdown = $(this).closest('.dropdown');
                $dropdown.find('.selected').text(selectedText);
                $dropdown.removeClass('active').addClass('has-value');
                $dropdown.find('.dropdown-list').removeClass('show');
            });

            // Document par click event to close dropdown if clicked outside
            $(document).on('click', function (e) {
                if (!$(e.target).closest('.dropdown').length) {
                    $('.dropdown').removeClass('active');
                    $('.dropdown-list').removeClass('show');
                }
            });

        });

        document.querySelectorAll('.custom-floating select').forEach(select => {
            // Function to update label state based on value
            function updateLabelState() {
                if (select.value && select.value !== '') {
                    select.parentElement.classList.add('floating');
                } else {
                    select.parentElement.classList.remove('floating');
                }
            }

            // Initial state
            updateLabelState();

            // Update on change
            select.addEventListener('change', updateLabelState);

            // Update on focus (no change unless value is non-empty)
            select.addEventListener('focus', updateLabelState);

            // Update on blur
            select.addEventListener('blur', updateLabelState);
        });


