    <asp:Literal ID="ltrScrpt" runat="server"></asp:Literal>
    <style>
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            box-sizing: border-box;
        }

        .page-wrapper {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            padding: 1.5rem;
            box-sizing: border-box;
            max-width: 100vw;
        }

        #MainContainer {
            flex: 1;
            max-width: 100%;
            box-sizing: border-box;
        }

        /* Increased padding to account for both navbars */
        .content-wrapper {
            padding-top: 100px; /* First navbar (~56px) + second navbar (~36px) + padding */
        }

        .form-floating .form-control,
        .form-floating .form-select {
            border: none;
            border-bottom: 2px solid #6c757d;
            border-radius: 0;
            outline: none;
            box-shadow: none;
            height: auto;
            padding-bottom: 0.1rem;
            padding-top: 1rem;
            width: 100%;
        }

        .form-floating .form-control:focus,
        .form-floating .form-select:focus {
            border-bottom: 3px solid #ff6200;
            outline: none;
            box-shadow: none;
        }

        .form-floating .form-control:not(:placeholder-shown),
        .form-floating .form-select:not(:placeholder-shown) {
            border-bottom: 3px solid #ff6200;
        }

        .form-floating .form-control::placeholder {
            color: transparent;
            opacity: 0;
        }

        .form-floating label {
            color: #6c757d;
            opacity: 1;
            transform: translateY(0.1rem);
            transition: all 0.2s ease;
            pointer-events: none;
        }

        .form-floating .form-control:focus ~ label,
        .form-floating .form-control:not(:placeholder-shown) ~ label {
            color: #ff6200;
            transform: translateY(-0.5rem) scale(0.75);
        }

        .form-floating .form-select {
            padding-top: 1rem;
            padding-bottom: 0.1rem;
        }

        .form-floating .form-select option[value=""] {
            color: #6c757d;
        }

        .form-floating .form-select:not(:placeholder-shown) {
            color: #000;
        }

        .d-flex.align-items-center .btn {
            margin-top: 0;
        }

        .form-floating .form-control-plaintext {
            border-bottom: 2px dotted gray;
            border-radius: 0;
            padding-bottom: 5px;
            width: 100%;
        }

        .form-floating .form-control-plaintext:focus {
            border-bottom: 2px dotted #808080;
            outline: none;
        }

        .form-floating .form-control.invalid {
            border-bottom: 3px solid red !important;
        }

        .form-floating label.invalid {
            color: red !important;
        }

        .container {
            max-width: 100%;
            padding-left: 15px;
            padding-right: 15px;
            box-sizing: border-box;
        }

        form {
            border: none;
        }

        @media (max-width: 575.98px) {
            .form-floating {
                margin-bottom: 1rem !important;
            }
            .row.mt-2 {
                margin-top: 0.5rem !important;
            }
            .page-wrapper {
                padding: 0.75rem;
            }
            .content-wrapper {
                padding-top: 90px; /* Adjusted for smaller navbar heights */
            }
        }

        @media (min-width: 576px) and (max-width: 991.98px) {
            .form-floating {
                margin-bottom: 1.5rem !important;
            }
            .page-wrapper {
                padding: 1rem;
            }
        }

/*        .bs-masked {
            overflow: hidden;
        }
        .bs-masked-relative {
            position: relative;
        }
        .bs-mask-overlay {
            display: none;
        }
        .test-container {
            width: 500px;
            height: 300px;
            border: 1px solid #ccc;
            margin: 50px auto;
            padding: 20px;
        }
  */

    </style>
</head>

<body id="mainPageBody">

        <!-- Navbar with Sidebar Toggle Button -->
    <nav class="navbar navbar-dark bg-dark">
        <div class="container-fluid">
            <button class="btn btn-primary" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu" aria-controls="sidebarMenu">
                Open Sidebar
            </button>
        </div>
    </nav>

    <!-- Sidebar Offcanvas -->
    <div class="offcanvas offcanvas-start bg-dark text-light" tabindex="-1" id="sidebarMenu" aria-labelledby="sidebarMenuLabel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title" id="sidebarMenuLabel">Admin Menu</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <ul class="list-unstyled">
                <li><a href="#" class="text-light">My Profile</a></li>
                <li><a href="#" class="text-light">User Management</a></li>
                <li><a href="#" class="text-light">Role Management</a></li>
                <li><a href="#" class="text-light">Settings</a></li>
            </ul>
        </div>
    </div>

    <div class="page-wrapper">
        <form id="frmMain" runat="server">
            <div id="MainContainer">
                <WP:eForms_Header ID="eForms_Header" runat="server" />
                <div class="content-wrapper">
                    <asp:ContentPlaceHolder ID="BuDastoorHome" runat="server">
                        <!-- Example form for testing -->
                        <div class="container text-center">
                            <div class="card">
                                <div class="card-body">
                                    <h5 class="card-title">Test Form</h5>
                                    <div class="form-floating mb-3">
                                        <input type="text" class="form-control" id="exampleInput" placeholder="Example">
                                        <label for="exampleInput">Example</label>
                                    </div>
                                    <div class="form-floating mb-3">
                                        <select class="form-select" id="exampleSelect">
                                            <option value="" selected>Select Option</option>
                                            <option value="1">Option 1</option>
                                            <option value="2">Option 2</option>
                                        </select>
                                        <label for="exampleSelect">Select Option</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </asp:ContentPlaceHolder>
                </div>
                <WP:eForms_Footer ID="eForms_Footer" runat="server" />
                <asp:HiddenField ID="_CurrentLang" runat="server" />
                <asp:HiddenField ID="_PostCountry" runat="server" />
            </div>
        </form>
    </div>


    <!-- Overlay with Spinner and Text -->
    <div class="overlay" id="loadingOverlay" style="display:none">
        <div class="spinner-container">
            <div class="sleek-spinner"></div>
            <div class="overlay-text">Please wait, loading your content...</div>
        </div>
    </div>
    <script type="text/javascript">
        $().ready(function () {
            $('.CopyRight').text(`Copyright © ${(new Date()).getFullYear()} All rights reserved.`);

            $('.form-floating .form-control').on('blur', function () {
                if (!$(this).val()) {
                    $(this).addClass('invalid');
                    $(this).siblings('label').addClass('invalid');
                } else {
                    $(this).removeClass('invalid');
                    $(this).siblings('label').removeClass('invalid');
                }
            });


        });
    </script>
    <script src="App_Themes/eForms_Theme/StyleSheets/bootstrap.bundle.min.js"></script>

</body>
</html>